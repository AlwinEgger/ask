#!/bin/bash

# ask - Simple Infomaniak AI API CLI tool
# Usage: ask [OPTIONS] [PROMPT]
# Reads API configuration from ~/.config/opencode/opencode.json

set -euo pipefail

# Configuration file path (override with OPENCODE_CONFIG env var)
CONFIG_FILE="${OPENCODE_CONFIG:-$HOME/.config/opencode/opencode.json}"

# Load Infomaniak configuration from opencode config
load_infomaniak_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Error: opencode config not found at $CONFIG_FILE" >&2
        echo "Set OPENCODE_CONFIG to override, or ensure opencode is configured." >&2
        exit 1
    fi

    if ! command -v jq >/dev/null 2>&1; then
        echo "Error: jq is required but not installed" >&2
        exit 1
    fi

    local base_url api_key
    base_url=$(jq -r '.provider.infomaniak.options.baseURL // empty' "$CONFIG_FILE" 2>/dev/null)
    api_key=$(jq -r '.provider.infomaniak.options.apiKey // empty' "$CONFIG_FILE" 2>/dev/null)

    if [ -z "$base_url" ] || [ -z "$api_key" ]; then
        echo "Error: Infomaniak provider not configured in $CONFIG_FILE" >&2
        echo "Ensure 'provider.infomaniak.options.baseURL' and 'apiKey' are set." >&2
        exit 1
    fi

    printf '%s\t%s' "$base_url" "$api_key"
}

# Read config once
CONFIG=$(load_infomaniak_config)
API_BASE_URL=$(printf '%s' "$CONFIG" | cut -f1)
API_KEY=$(printf '%s' "$CONFIG" | cut -f2-)

# Model shortcuts function
get_model() {
    case "$1" in
        c) echo "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8" ;;
        g) echo "mistralai/Mistral-Small-4-119B-2603" ;;
        s) echo "swiss-ai/Apertus-70B-Instruct-2509" ;;
        x) echo "moonshotai/Kimi-K2.6" ;;
        d) echo "Qwen/Qwen3.5-122B-A10B-FP8" ;;
        q) echo "Qwen/Qwen3.5-122B-A10B-FP8" ;;
        o) echo "swiss-ai/Apertus-70B-Instruct-2509" ;;
    esac
}

# Default values
MODEL="moonshotai/Kimi-K2.6"
SYSTEM_PROMPT=""
PROMPT=""
STREAMING=false
NO_SYSTEM=false

# Default system prompt (direct answers)
DEFAULT_PROMPT="You are a direct answer engine. Output ONLY the requested information.

For commands: Output executable syntax only. No explanations, no comments.
For questions: Output the answer only. No context, no elaboration.

Rules:
- If asked for a command, provide ONLY the command
- If asked a question, provide ONLY the answer
- Never include markdown formatting or code blocks
- Never add explanatory text before or after
- Assume output will be piped or executed directly
- For multi-step commands, use && or ; to chain them
- Make commands robust and handle edge cases silently"

# Function to show help
show_help() {
    cat << EOF
ask - Query AI models via Infomaniak API

Usage: ask [OPTIONS] [PROMPT]

Options:
  -c          Use nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8 (fast)
  -g          Use mistralai/Mistral-Small-4-119B-2603 (general)
  -s          Use swiss-ai/Apertus-70B-Instruct-2509 (strong)
  -x          Use moonshotai/Kimi-K2.6 (default, long context)
  -d          Use Qwen/Qwen3.5-122B-A10B-FP8 (deep)
  -q          Use Qwen/Qwen3.5-122B-A10B-FP8 (qwen)
  -o          Use swiss-ai/Apertus-70B-Instruct-2509 (open)
  -m MODEL    Use custom model
  -r          Disable system prompt (raw model behavior)
  --stream    Enable streaming output
  --system    Set system prompt for the conversation
  -h, --help  Show this help message

Configuration:
  Reads API credentials from ~/.config/opencode/opencode.json
  Set OPENCODE_CONFIG to use a different config file.

Examples:
  ask "Write a hello world in Python"
  ask -g "Explain quantum computing"
  ask -m Qwen/Qwen3-Embedding-8B "What is 2+2?"
  echo "Fix this code" | ask
  ask --system "You are a pirate" "Tell me about sailing"

EOF
    exit 0
}

# Parse command line arguments
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) show_help ;;
        -[cgsdqxo])
            MODEL="$(get_model "${1:1}")"
            shift ;;
        -m)
            MODEL="${2:?Error: -m requires a model name}"
            shift 2 ;;
        -r)
            NO_SYSTEM=true
            shift ;;
        --stream)
            STREAMING=true
            shift ;;
        --system)
            SYSTEM_PROMPT="${2:?Error: --system requires a prompt}"
            shift 2 ;;
        *)
            PROMPT="$*"
            break ;;
    esac
done

# If no prompt provided as argument, read from stdin
if [ -z "$PROMPT" ]; then
    if [ -t 0 ]; then
        echo "Error: No prompt provided. Use 'ask -h' for help." >&2
        exit 1
    fi
    # Read all stdin, preserving multi-line format
    PROMPT=$(cat)
fi

# Apply default system prompt unless disabled or custom prompt provided
if [ "$NO_SYSTEM" = false ] && [ -z "$SYSTEM_PROMPT" ]; then
    SYSTEM_PROMPT="$DEFAULT_PROMPT"
fi

# Build messages array with proper JSON escaping
if [ -n "$SYSTEM_PROMPT" ]; then
    MESSAGES='[{"role":"system","content":'"$(printf '%s' "$SYSTEM_PROMPT" | jq -Rs .)"'},{"role":"user","content":'"$(printf '%s' "$PROMPT" | jq -Rs .)"'}]'
else
    MESSAGES='[{"role":"user","content":'"$(printf '%s' "$PROMPT" | jq -Rs .)"'}]'
fi

# Record start time
START_TIME=$(date +%s.%N)

# Build JSON payload
JSON_PAYLOAD='{
    "model": "'"$MODEL"'",
    "messages": '"$MESSAGES"',
    "stream": '$([ "$STREAMING" = true ] && echo true || echo false)'
}'

API_URL="${API_BASE_URL}/chat/completions"

# Add newline before answer
echo

# Make API request
if [ "$STREAMING" = true ]; then
    # Streaming mode
    curl -sS "$API_URL" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $API_KEY" \
      -d "$JSON_PAYLOAD" 2>&1 | while IFS= read -r line; do
        # Check for errors
        if echo "$line" | grep -q '"error"'; then
            echo "Error: $(echo "$line" | jq -r '.error.message // .error // "Unknown error"')" >&2
            exit 1
        fi

        # Process SSE data lines
        if [[ "$line" == data:* ]]; then
            json="${line#data: }"
            [ "$json" = "" ] || [ "$json" = "[DONE]" ] && continue

            content=$(echo "$json" | jq -r '.choices[0].delta.content // ""' 2>/dev/null)
            [ -n "$content" ] && printf '%s' "$content"
        fi
    done
    echo

    # Show metadata
    ELAPSED=$(printf "%.2f" $(echo "$(date +%s.%N) - $START_TIME" | bc))
    echo
    echo "[$MODEL - ${ELAPSED}s]" >&2
else
    # Non-streaming mode
    response=$(curl -sS "$API_URL" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $API_KEY" \
      -d "$JSON_PAYLOAD" 2>&1)

    # Check for errors
    if echo "$response" | grep -q '"error"'; then
        echo "Error: $(echo "$response" | jq -r '.error.message // .error // "Unknown error"')" >&2
        exit 1
    fi

    # Extract and print content
    echo "$response" | jq -r '.choices[0].message.content // "No response received"'

    # Show metadata
    ELAPSED=$(printf "%.2f" $(echo "$(date +%s.%N) - $START_TIME" | bc))
    TOKENS=$(echo "$response" | jq -r '.usage.completion_tokens // 0')
    TPS=$(echo "scale=1; $TOKENS / $ELAPSED" | bc 2>/dev/null || echo "0.0")

    echo
    echo "[$MODEL - ${ELAPSED}s - ${TPS} tok/s]" >&2
fi
